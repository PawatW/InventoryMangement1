# ============================================================
# Environment Variables — คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่า
# Copy this file to .env and fill in the values below
# ============================================================

# --- Database ---
# รหัสผ่าน PostgreSQL (ตั้งได้เอง)
DB_PASSWORD=changeme123

# --- JWT ---
# Secret key สำหรับเซ็น JWT — Base64 ของ string ยาวอย่างน้อย 32 ตัวอักษร
# สร้างด้วย: openssl rand -base64 64
JWT_SECRET=bXlTdXBlclNlY3JldEtleUZvckpXVFRva2VuSW52ZW50b3J5TWFuYWdlbWVudFN5c3RlbTEyMzQ1Njc4OTA=

# --- Cloudinary (อัพโหลดรูปสินค้า / สลิปการชำระเงิน) ---
# สมัครฟรีได้ที่ https://cloudinary.com → Dashboard → API Keys
# รูปแบบ: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz@your-cloud-name

# --- Frontend API URL ---
# ค่าเริ่มต้น http://localhost:8080 ใช้ได้บน local
# แก้เมื่อ deploy บน server ชื่อ host อื่น:
# NEXT_PUBLIC_API_URL=http://your-server-ip:8080
